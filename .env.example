# --- Yerel geliştirme (docker compose: npm run db:start) ---
DATABASE_URL="postgres://randevu:randevu@localhost:5433/randevu"
TEST_DATABASE_URL="postgres://randevu:randevu@localhost:5433/randevu_test"

# --- Vercel + Neon (Marketplace entegrasyonu bunları OTOMATİK ekler; elle yazmayın) ---
# DATABASE_URL            : pooled (PgBouncer) adres, uygulama çalışırken kullanılır
# DATABASE_URL_UNPOOLED   : direkt adres, build sırasında migration için (scripts/deploy-db.ts)
# Yerelde Neon'a migrate etmek isterseniz: DATABASE_URL_UNPOOLED="postgresql://...neon.tech/neondb?sslmode=require"

# --- Demo sıfırlama (Vercel'de elle ekleyin; GitHub'da aynı değer DEMO_RESET_SECRET olarak) ---
# Üretmek için: openssl rand -hex 32
DEMO_RESET_SECRET=""

# --- İsteğe bağlı ---
# Build sırasında demo salonu kurulumunu kapatır (varsayılan: açık, yalnız demo yoksa kurar)
# SEED_DEMO=false
# Randevu IP hız sınırı üst değeri (varsayılan 10 / 10 dk; e2e 1000 kullanır)
# BOOKING_RATE_MAX=10
# Serverless + Neon pooler bağlantı havuzu (varsayılanlar): 
# DB_POOL_MAX=3 · DB_IDLE_TIMEOUT=20 (sn) · DB_CONNECT_TIMEOUT=10 (sn) · DB_MAX_LIFETIME=1800 (sn)
